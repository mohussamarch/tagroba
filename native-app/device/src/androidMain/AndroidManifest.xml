<?xml version="1.0" encoding="utf-8"?>
<!-- رسايل البنك (OVERRIDES §21 و§38 في التطبيق الحالي): القراية بطلب المستخدم + صندوق في الخلفية للمرسلين اللي فعّلهم بس -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <application>
        <receiver android:name="app.masroufy.device.BankSmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter><action android:name="android.provider.Telephony.SMS_RECEIVED" /></intent-filter>
        </receiver>
    </application>
</manifest>
