    "calmEasing": "cubic-bezier(.2,.7,.3,1)",
    "reduceMotion": "no transform or continuous animation",
    "liquidMenuOpen": "420ms cubic-bezier(.18,.9,.28,1.08)",
    "liftRow": "400ms",
    "springs": {
      "snappy": {
        "use": "press, tabs, toggles",
        "css": "220ms cubic-bezier(.2,.7,.3,1)",
        "compose": "spring(dampingRatio = Spring.DampingRatioNoBouncy, stiffness = Spring.StiffnessMedium)"
      },
      "gentle": {
        "use": "pages, sheets, hero entrance, numbers",
        "css": "450ms cubic-bezier(.2,.7,.3,1)",
        "compose": "spring(dampingRatio = Spring.DampingRatioNoBouncy, stiffness = Spring.StiffnessLow)"
      },
      "bouncy": {
        "use": "liquid glass only: popup menu, lifted row, selected lens",
        "css": "420ms cubic-bezier(.18,.9,.28,1.08)",
        "compose": "spring(dampingRatio = Spring.DampingRatioLowBouncy, stiffness = Spring.StiffnessMediumLow)"
      }
    },
    "rules": [
      "every animated element has one resting state and returns to it",
      "interrupted motion continues from its current value",
      "reduce motion: opacity fades <= 150ms only",
      "motion never blocks input",
      "review every motion at normal and quarter speed before porting"
    ],
    "reduceMotionFadeMs": 150
  },
  "touch": {
    "minimumDp": 48
  },
