rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // قاعدة التجار المشتركة — OVERRIDES §25 و§25.1.
    // أي مستخدم داخل بيقرا، ويضيف أو يعدّل تاجر مش مؤكد بالحقول دي بس.
    // «مؤكد» بيتكتب من لوحة فايربيز بس (اللوحة مش بتمر بالقواعد)، ومفيش مسح.
    match /sharedMerchants/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validSharedMerchant(key);
      allow update: if request.auth != null
                    && resource.data.confirmed == false
                    && validSharedMerchant(key);
      allow delete: if false;
    }

    // كل اسم بديل نص من 1 لـ80 حرف، وحتى 10 — القواعد مفيهاش لفّ، فكل خانة بتتفحص لوحدها (بند Codex §38-3)
    function validAlias(list, i) {
      return list.size() <= i || (list[i] is string && list[i].size() > 0 && list[i].size() <= 80);
    }

    function validAliases(list) {
      return list is list && list.size() <= 10
          && validAlias(list, 0) && validAlias(list, 1) && validAlias(list, 2) && validAlias(list, 3)
          && validAlias(list, 4) && validAlias(list, 5) && validAlias(list, 6) && validAlias(list, 7)
          && validAlias(list, 8) && validAlias(list, 9);
    }

    function validSharedMerchant(key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['normalizedName', 'displayName', 'aliases', 'categoryId', 'confirmed', 'updatedAt'])
          && d.keys().hasAll(['normalizedName', 'displayName', 'aliases', 'categoryId', 'confirmed', 'updatedAt'])
          && d.normalizedName is string && d.normalizedName.size() > 0 && d.normalizedName.size() <= 80
          && d.normalizedName.replace(' ', '-') == key
          && d.displayName is string && d.displayName.size() <= 80
          && validAliases(d.aliases)
          && (d.categoryId == null || (d.categoryId is string && d.categoryId.size() <= 120))
          && d.confirmed == false
          && d.updatedAt == request.time;
    }
  }
}
